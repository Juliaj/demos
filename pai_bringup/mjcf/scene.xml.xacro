<?xml version="1.0"?>
<mujoco model="so_arm101 scene" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find pai_bringup)/config/world/poses_args.xacro"/>
  <xacro:declare_poses_args/>

  <include file="so_arm101.xml" />

  <statistic center="0 -0.01 0.45" extent="1.5" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="45" elevation="-20" />
  </visual>

  <asset>
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0 0 0"
      width="512"
      height="3072"
    />
    <texture
      type="2d"
      name="groundplane"
      builtin="checker"
      mark="edge"
      rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8"
      width="300"
      height="300"
    />
    <material
      name="groundplane"
      texture="groundplane"
      texuniform="true"
      texrepeat="5 5"
      reflectance="0.2"
    />
    <material name="table_leg" rgba="0.82 0.84 0.86 1" />
    <material name="table_top" rgba="0.18 0.18 0.2 1" reflectance="0.12" />
    <material name="mat_surface" rgba="0.12 0.12 0.14 1" reflectance="0.05" />
    <material name="bowl" rgba="0.95 0.95 0.96 1" reflectance="0.2" />
    <material name="cube_blue" rgba="0.2 0.4 0.9 1" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
    <body name="table" pos="$(arg table_x) $(arg table_y) $(arg table_z)">
      <geom name="table_top" type="box" size="0.33 0.3 0.013" material="table_top" friction="0.7 0.1 0.1" />
      <geom name="leg_fl" type="box" pos="-0.315 0.285 -0.1965" size="0.015 0.015 0.1835" material="table_leg" />
      <geom name="leg_fr" type="box" pos="0.315 0.285 -0.1965" size="0.015 0.015 0.1835" material="table_leg" />
      <geom name="leg_bl" type="box" pos="-0.315 -0.285 -0.1965" size="0.015 0.015 0.1835" material="table_leg" />
      <geom name="leg_br" type="box" pos="0.315 -0.285 -0.1965" size="0.015 0.015 0.1835" material="table_leg" />
    </body>
    <!-- Dark mat on table (matches real WOWROBOT mat) -->
    <body name="mat" pos="$(arg tray_x) $(arg tray_y) $(arg tray_z)">
      <geom name="mat_surface" type="box" size="0.18 0.14 0.001" material="mat_surface" friction="0.7 0.1 0.1" />
    </body>
    <!-- Bowl: white ceramic, ~12cm diameter, ~6cm tall (matches real setup) -->
    <body name="bowl" pos="$(arg tray_x) $(arg tray_y) $(arg tray_z)">
      <!-- Bowl approximated as a cylinder with open top -->
      <geom name="bowl_base" type="cylinder" size="0.055 0.002" material="bowl" friction="0.7 0.1 0.1" />
      <geom name="bowl_wall" type="cylinder" size="0.06 0.03" pos="0 0 0.03" material="bowl"
            friction="0.7 0.1 0.1" contype="1" conaffinity="1" shellinertia="true" />
      <geom name="bowl_inner" type="cylinder" size="0.052 0.028" pos="0 0 0.032"
            contype="0" conaffinity="0" group="3" rgba="0 0 0 0" />
    </body>
    <!-- Single blue cube (matches real training scene) -->
    <body name="cube_blue" pos="$(arg cube_large_x) $(arg cube_large_y) $(arg cube_large_z)">
      <freejoint name="cube_blue_joint" />
      <geom name="cube_blue_geom" type="box" size="0.0125 0.0125 0.0125" mass="0.02" material="cube_blue" friction="0.7 0.1 0.1" />
    </body>
  </worldbody>

  <!-- Resting pose matching real SO-ARM101 power-on position.
       qpos order: 6 arm joints, then cube freejoint (x y z qw qx qy qz).
       ctrl order: 6 actuators (arm joints only). -->
  <keyframe>
    <key name="rest"
         qpos="0.103 -1.793 1.54 1.226 -0.120 0.0
               $(arg cube_large_x) $(arg cube_large_y) $(arg cube_large_z) 1 0 0 0"
         ctrl="0.103 -1.793 1.54 1.226 -0.120 0.0"/>
  </keyframe>
</mujoco>
